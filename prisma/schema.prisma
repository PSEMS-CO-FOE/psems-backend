generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The spec's 7 permission roles plus LECTURER: an approved lecturer who has
// no CPI-scoped role yet. Supervisor/Evaluator/Head Judge are per-CPI roles a
// lecturer takes on via junction tables (Week 3); LECTURER is the account-level
// base identity they hold in between.
enum Role {
  SUPER_ADMIN
  SYSTEM_ADMIN
  COURSE_COORDINATOR
  LECTURER
  SUPERVISOR
  EVALUATOR
  HEAD_JUDGE
  STUDENT
}

enum LecturerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CpiMode {
  SUPERVISOR_LED
  COORDINATOR_MANAGED
}

enum CpiProjectType {
  FYP
  DATA_MANAGEMENT
  HPC
  INNOVATION_CHALLENGE
}

// Whether students take part as groups or individually (spec 3.3 Step 1).
// Stored at creation; acted on in Week 4's group formation.
enum CpiParticipationMode {
  GROUP
  INDIVIDUAL
}

// Supervisor invitations must be accepted by the lecturer (spec 3.3 Step 3);
// reused for group-membership invites too (leader invites → member accepts).
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Who authored a project idea (spec 3.3 Step 5 / table project_ideas).
enum IdeaAuthorType {
  SUPERVISOR
  COORDINATOR
  STUDENT
}

// Visibility class, set from author type at creation. PUBLIC_TO_STUDENTS =
// every student may see it; GROUP_RESTRICTED = only the author's group (plus
// supervisors/coordinator). The real access check is per-requester in the list
// query — this is a readable label.
enum IdeaVisibility {
  PUBLIC_TO_STUDENTS
  GROUP_RESTRICTED
}

// Coordinator's accept/reject decision on a student idea — only meaningful in
// Coordinator-Managed mode (spec 3.3 Step 5). Null for all other ideas.
enum IdeaApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// The three kinds of Expression of Interest at Project Selection (spec 3.3
// Step 6 / table interest_expressions):
//   GROUP_INTEREST     — a group ranks a supervisor-posted idea (rank 1–3)
//   SEEKING_SUPERVISOR — a group flags its OWN idea, inviting supervisors
//   SUPERVISOR_WILLING — a supervisor marks willingness on a student idea
enum EoiType {
  GROUP_INTEREST
  SEEKING_SUPERVISOR
  SUPERVISOR_WILLING
}

// Mutual-confirmation outcome for a group's chosen project (spec 3.3 Step 6 /
// table project_selections). PENDING until the supervisor (Supervisor-Led) or
// coordinator (Coordinator-Managed) responds.
enum SelectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// How an allocation row came to be (spec 3.3 Step 7). Either derived from a
// group's accepted selection, or set/changed by a coordinator override.
enum AllocationSource {
  FROM_SELECTION
  COORDINATOR_OVERRIDE
}

enum SessionStatus {
  SCHEDULED
  AWAITING_HEAD_JUDGE
  CORRECTION_REQUESTED
  FINALIZED
}

// A rubric score is locked once the Head Judge finalizes its session (spec Flow B).
enum RubricScoreStatus {
  PENDING
  FINALIZED
}

enum HeadJudgeDecision {
  APPROVED
  CORRECTION_REQUESTED
}

// 10 phases per CPI (spec 3.2) — every system action is gated to one of these.
enum CpiPhase {
  STUDENT_REGISTRATION
  SUPERVISOR_ADDITION
  IDEA_ANNOUNCEMENT
  PROJECT_SELECTION
  PROJECT_REGISTRATION
  EVALUATION_CONFIG
  PROPOSAL_SUBMISSION
  AVAILABILITY_SUBMISSION
  EVALUATION_EXECUTION
  FINAL_SUBMISSION
}

// All system users. `forcePasswordChange` is the single source of truth for
// the forced first-login flow (spec 9.1) — deliberately not duplicated on
// Student, to avoid two flags that can drift out of sync.
model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  fullName            String   @default("") @map("full_name")
  passwordHash        String   @map("password_hash")
  role                Role
  forcePasswordChange Boolean  @default(false) @map("force_password_change")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  student           Student?
  lecturer          Lecturer?
  createdCpis       CourseInstance[] @relation("CpiCreatedBy")
  auditLogs         AuditLog[]
  provisioningLogs  StudentProvisioningLog[]
  postedIdeas       ProjectIdea[]
  notifications     Notification[]

  @@map("users")
}

// Extended profile for STUDENT-role users (spec 7.1).
model Student {
  id                 String  @id @default(uuid())
  userId             String  @unique @map("user_id")
  studentId          String  @unique @map("student_id")
  department         String
  year               Int
  provisioningStatus String  @default("ACTIVE") @map("provisioning_status")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledGroups        Group[]       @relation("GroupLeader")
  groupMemberships GroupMember[]

  @@map("students")
}

// Extended profile for lecturer-type users (Course Coordinator / Supervisor /
// Evaluator / Head Judge are CPI-scoped roles a lecturer plays, added in
// Week 3 via junction tables — this is the base account record).
model Lecturer {
  id               String                 @id @default(uuid())
  userId           String                 @unique @map("user_id")
  selfRegistered   Boolean                @default(false) @map("self_registered")
  approvalStatus   LecturerApprovalStatus @default(PENDING) @map("approval_status")

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpiSupervisorRoles    CpiSupervisor[]
  cpiEvaluatorRoles     CpiEvaluator[]
  willingExpressions    InterestExpression[]
  supervisorSelections  ProjectSelection[]
  supervisorAllocations ProjectAllocation[]

  @@map("lecturers")
}

// A single run of a project-based course in a given semester/department
// (spec 3.1). Mode is determined automatically at Step 3 of the lifecycle —
// nullable until the coordinator adds supervisors or explicitly skips.
model CourseInstance {
  id                    String               @id @default(uuid())
  name                  String // e.g. "Computer Engineering FYP 2026"
  projectType           CpiProjectType       @map("project_type")
  participationMode     CpiParticipationMode @map("participation_mode")
  department            String
  academicYear          String               @map("academic_year")
  mode                  CpiMode?
  allocationsFinalizedAt DateTime?           @map("allocations_finalized_at")
  marksPublishedAt      DateTime?            @map("marks_published_at")
  createdById           String               @map("created_by_id")
  createdAt             DateTime             @default(now()) @map("created_at")

  createdBy           User                 @relation("CpiCreatedBy", fields: [createdById], references: [id])
  timeline            CpiTimeline[]
  supervisors         CpiSupervisor[]
  evaluators          CpiEvaluator[]
  groups              Group[]
  ideas               ProjectIdea[]
  interestExpressions InterestExpression[]
  projectSelections   ProjectSelection[]
  allocations         ProjectAllocation[]
  evaluationStages    EvaluationStage[]
  submissions         Submission[]
  availability        EvaluatorAvailability[]
  evaluationSessions  EvaluationSession[]
  finalMarks          FinalMark[]

  @@map("course_instances")
}

// Which lecturers the coordinator invited as supervisors for a CPI (spec 3.3
// Step 3 / table cpi_supervisors). The presence of ANY row flips the CPI into
// Supervisor-Led mode; each invite must be accepted by the lecturer.
model CpiSupervisor {
  id               String           @id @default(uuid())
  courseInstanceId String           @map("course_instance_id")
  lecturerId       String           @map("lecturer_id")
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")
  invitedAt        DateTime         @default(now()) @map("invited_at")
  respondedAt      DateTime?        @map("responded_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  lecturer       Lecturer       @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([courseInstanceId, lecturerId])
  @@map("cpi_supervisors")
}

// The CPI's evaluator pool + which one is Head Judge (spec 3.3 Step 3). Exists
// in both modes. Exactly one isHeadJudge=true per CPI (enforced in the service).
model CpiEvaluator {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  lecturerId       String   @map("lecturer_id")
  isHeadJudge      Boolean  @default(false) @map("is_head_judge")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  courseInstance   CourseInstance          @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  lecturer         Lecturer                @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  stageAssignments StageEvaluator[]
  availability     EvaluatorAvailability[]
  rubricScores     RubricScore[]

  @@unique([courseInstanceId, lecturerId])
  @@map("cpi_evaluators")
}

// A student project group within a CPI (spec 3.3 Step 4). Mutable only during
// STUDENT_REGISTRATION; "locked" afterward is derived from the timeline, not stored.
model Group {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  name             String
  leaderStudentId  String   @map("leader_student_id")
  createdAt        DateTime @default(now()) @map("created_at")

  courseInstance      CourseInstance       @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  leader              Student              @relation("GroupLeader", fields: [leaderStudentId], references: [id])
  members             GroupMember[]
  ideas               ProjectIdea[]
  interestExpressions InterestExpression[]
  projectSelections   ProjectSelection[]
  allocation          ProjectAllocation?
  submissions         Submission[]
  evaluationSessions  EvaluationSession[]
  finalMarks          FinalMark[]

  @@index([courseInstanceId])
  @@map("groups")
}

// Group membership + invite/accept flow (spec table group_members). Leader's row
// is ACCEPTED at creation; invitees start PENDING. "One accepted group per
// student per CPI" is enforced in the service layer.
model GroupMember {
  id        String           @id @default(uuid())
  groupId   String           @map("group_id")
  studentId String           @map("student_id")
  status    InvitationStatus @default(PENDING)
  invitedAt DateTime         @default(now()) @map("invited_at")
  joinedAt  DateTime?        @map("joined_at")

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
  @@map("group_members")
}

// A project idea (spec 3.3 Step 5). Author linkage by authorType: SUPERVISOR/
// COORDINATOR set authorUserId only; STUDENT sets authorUserId + groupId.
// approvalStatus is only set for STUDENT ideas in Coordinator-Managed mode.
// similarityFlag is a placeholder for the Week 9 ML similarity check.
model ProjectIdea {
  id               String              @id @default(uuid())
  courseInstanceId String              @map("course_instance_id")
  authorType       IdeaAuthorType      @map("author_type")
  authorUserId     String              @map("author_user_id")
  groupId          String?             @map("group_id")
  title            String
  description      String
  visibility       IdeaVisibility
  approvalStatus   IdeaApprovalStatus? @map("approval_status")
  similarityFlag   Boolean             @default(false) @map("similarity_flag")
  createdAt        DateTime            @default(now()) @map("created_at")

  courseInstance      CourseInstance       @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  author              User                 @relation(fields: [authorUserId], references: [id])
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  interestExpressions InterestExpression[]
  projectSelections   ProjectSelection[]
  allocations         ProjectAllocation[]

  @@index([courseInstanceId])
  @@index([groupId])
  @@map("project_ideas")
}

// Expression of Interest at Project Selection (spec 3.3 Step 6 / table
// interest_expressions). One row per (group ranks an idea) / (group seeks a
// supervisor for its own idea) / (supervisor is willing on a student idea).
// Exactly one of groupId / supervisorLecturerId is set, per `type`.
model InterestExpression {
  id                   String   @id @default(uuid())
  courseInstanceId     String   @map("course_instance_id")
  ideaId               String   @map("idea_id")
  type                 EoiType
  groupId              String?  @map("group_id")
  supervisorLecturerId String?  @map("supervisor_lecturer_id")
  rank                 Int? // 1–3, only for GROUP_INTEREST
  createdAt            DateTime @default(now()) @map("created_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  idea           ProjectIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  group          Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  supervisor     Lecturer?      @relation(fields: [supervisorLecturerId], references: [id], onDelete: Cascade)

  // A group ranks a given idea at most once; a supervisor is willing on a given
  // idea at most once. (Partial semantics differ by type but the pair is unique
  // either way since only one of group/supervisor is set.)
  @@unique([groupId, ideaId, type])
  @@unique([supervisorLecturerId, ideaId, type])
  @@index([courseInstanceId])
  @@index([ideaId])
  @@map("interest_expressions")
}

// A group's final project selection and its mutual-confirmation outcome (spec
// 3.3 Step 6 / table project_selections). supervisorLecturerId is set in
// Supervisor-Led (the supervisor who must accept), null in Coordinator-Managed
// (the coordinator approves). "One active (non-declined) selection per group"
// is enforced in the service layer.
model ProjectSelection {
  id                   String          @id @default(uuid())
  courseInstanceId     String          @map("course_instance_id")
  groupId              String          @map("group_id")
  ideaId               String          @map("idea_id")
  supervisorLecturerId String?         @map("supervisor_lecturer_id")
  status               SelectionStatus @default(PENDING)
  createdAt            DateTime        @default(now()) @map("created_at")
  respondedAt          DateTime?       @map("responded_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  idea           ProjectIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  supervisor     Lecturer?      @relation(fields: [supervisorLecturerId], references: [id], onDelete: Cascade)

  @@index([courseInstanceId])
  @@index([groupId])
  @@map("project_selections")
}

// Finalized group ↔ project ↔ supervisor assignment (spec 3.3 Step 7 / table
// project_allocations). One per group. Seeded from accepted selections, then
// editable by the coordinator until the CPI's allocations are finalized
// (CourseInstance.allocationsFinalizedAt).
model ProjectAllocation {
  id                   String           @id @default(uuid())
  courseInstanceId     String           @map("course_instance_id")
  groupId              String           @unique @map("group_id")
  ideaId               String           @map("idea_id")
  supervisorLecturerId String?          @map("supervisor_lecturer_id")
  source               AllocationSource @default(FROM_SELECTION)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  idea           ProjectIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  supervisor     Lecturer?      @relation(fields: [supervisorLecturerId], references: [id], onDelete: Cascade)

  @@index([courseInstanceId])
  @@map("project_allocations")
}

// A customizable evaluation stage (spec 3.3 Step 8 / table evaluation_stages).
// weight is a percentage; stage weights sum to 100 across the CPI.
model EvaluationStage {
  id                 String   @id @default(uuid())
  courseInstanceId   String   @map("course_instance_id")
  name               String
  weight             Int // percent; stages sum to 100 per CPI
  evaluatorsRequired Int      @map("evaluators_required")
  submissionRequired Boolean  @default(false) @map("submission_required")
  orderIndex         Int      @map("order_index")
  createdAt          DateTime @default(now()) @map("created_at")

  courseInstance CourseInstance      @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  criteria       RubricCriterion[]
  evaluators     StageEvaluator[]
  submissions    Submission[]
  sessions       EvaluationSession[]
  finalMarks     FinalMark[]

  @@index([courseInstanceId])
  @@map("evaluation_stages")
}

// A rubric criterion within a stage (spec table rubric_criteria). weight is a
// percentage; criteria weights sum to 100 within their stage.
model RubricCriterion {
  id                String  @id @default(uuid())
  evaluationStageId String  @map("evaluation_stage_id")
  name              String
  description       String?
  weight            Int // percent within the stage; criteria sum to 100
  maxScore          Int     @map("max_score")
  orderIndex        Int     @map("order_index")

  stage  EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  scores RubricScore[]

  @@index([evaluationStageId])
  @@map("rubric_criteria")
}

// Which CPI evaluators are assigned to a given stage (spec 3.3 Step 8: "assigns
// specific evaluators per stage"). References the CPI-level evaluator pool row.
model StageEvaluator {
  id                String @id @default(uuid())
  evaluationStageId String @map("evaluation_stage_id")
  cpiEvaluatorId    String @map("cpi_evaluator_id")

  stage        EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  cpiEvaluator CpiEvaluator    @relation(fields: [cpiEvaluatorId], references: [id], onDelete: Cascade)

  @@unique([evaluationStageId, cpiEvaluatorId])
  @@map("stage_evaluators")
}

// A group's file submission for a stage (spec 3.3 Step 9 / table submissions).
// storagePath is backend-agnostic (local path or Supabase object key). isLate
// is computed against the submission window at upload time — the deadline is
// SOFT (late uploads are accepted and flagged, per spec "late submissions
// flagged to coordinator"). One current submission per group per stage.
model Submission {
  id                String   @id @default(uuid())
  courseInstanceId  String   @map("course_instance_id")
  groupId           String   @map("group_id")
  evaluationStageId String   @map("evaluation_stage_id")
  storagePath       String   @map("storage_path")
  fileName          String   @map("file_name")
  fileSize          Int      @map("file_size")
  isLate            Boolean  @default(false) @map("is_late")
  submittedAt       DateTime @default(now()) @map("submitted_at")

  courseInstance CourseInstance  @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@unique([groupId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("submissions")
}

// Availability slots an evaluator offers for scheduling (spec 3.3 Step 8 / table
// evaluator_availability).
model EvaluatorAvailability {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  cpiEvaluatorId   String   @map("cpi_evaluator_id")
  slotStart        DateTime @map("slot_start")
  slotEnd          DateTime @map("slot_end")
  createdAt        DateTime @default(now()) @map("created_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  cpiEvaluator   CpiEvaluator   @relation(fields: [cpiEvaluatorId], references: [id], onDelete: Cascade)

  @@index([courseInstanceId])
  @@map("evaluator_availability")
}

// A scheduled evaluation of one group at one stage (spec table
// evaluation_sessions). Its evaluators are the stage's assigned evaluators;
// scores hang off it. status tracks the Flow B lifecycle.
model EvaluationSession {
  id                String        @id @default(uuid())
  courseInstanceId  String        @map("course_instance_id")
  groupId           String        @map("group_id")
  evaluationStageId String        @map("evaluation_stage_id")
  scheduledStart    DateTime?     @map("scheduled_start")
  scheduledEnd      DateTime?     @map("scheduled_end")
  status            SessionStatus @default(SCHEDULED)
  createdAt         DateTime      @default(now()) @map("created_at")

  courseInstance CourseInstance   @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage  @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  scores         RubricScore[]
  review         HeadJudgeReview?

  @@unique([groupId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("evaluation_sessions")
}

// One evaluator's score for one criterion in a session (spec table rubric_scores).
// Isolation (evaluators can't see each other's scores before HJ review) is
// enforced in the service read path, not here. Locked once status=FINALIZED.
model RubricScore {
  id                  String            @id @default(uuid())
  evaluationSessionId String            @map("evaluation_session_id")
  cpiEvaluatorId      String            @map("cpi_evaluator_id")
  rubricCriterionId   String            @map("rubric_criterion_id")
  score               Int
  comment             String?
  status              RubricScoreStatus @default(PENDING)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  session      EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  cpiEvaluator CpiEvaluator      @relation(fields: [cpiEvaluatorId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion   @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationSessionId, cpiEvaluatorId, rubricCriterionId])
  @@index([evaluationSessionId])
  @@map("rubric_scores")
}

// The Head Judge's decision on a session (spec table head_judge_reviews). One
// row per session, updated on each decision; correctionEvaluatorId names the
// evaluator asked to resubmit.
model HeadJudgeReview {
  id                      String            @id @default(uuid())
  evaluationSessionId     String            @unique @map("evaluation_session_id")
  headJudgeCpiEvaluatorId String            @map("head_judge_cpi_evaluator_id")
  decision                HeadJudgeDecision
  reason                  String?
  correctionEvaluatorId   String?           @map("correction_evaluator_id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  session EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@map("head_judge_reviews")
}

// Phase start/end dates per CPI — one row per phase (spec 7.1).
model CpiTimeline {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  phase            CpiPhase
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)

  @@unique([courseInstanceId, phase])
  @@map("cpi_timelines")
}

// Append-only trail of every write operation (spec 7.1: "never deleted").
// actorId is nullable so unauthenticated writes (login attempts, lecturer
// self-registration) are still recorded. payloadHash is a SHA-256 of the
// request body — a fingerprint for integrity disputes without ever storing
// raw payload contents (which may include passwords or student PII).
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  action      String // e.g. "POST /students/bulk-provision"
  resource    String // route path actually hit, with params resolved
  payloadHash String?  @map("payload_hash")
  statusCode  Int      @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

// One row per student per bulk-provisioning batch (spec 2.2): records that
// the credential email was dispatched and whether it arrived, so failed
// deliveries can be flagged for System Admin review.
model StudentProvisioningLog {
  id             String              @id @default(uuid())
  batchId        String              @map("batch_id")
  userId         String              @map("user_id")
  email          String
  deliveryStatus EmailDeliveryStatus @default(QUEUED) @map("delivery_status")
  failureReason  String?             @map("failure_reason")
  dispatchedAt   DateTime?           @map("dispatched_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([deliveryStatus])
  @@map("student_provisioning_log")
}

// Aggregated mark per group per stage (spec 3.3 Step 11 / table final_marks).
// stageScorePercent is the stage's 0–100 result; weightedContribution applies
// the stage weight. Overall = sum of weightedContribution per group.
model FinalMark {
  id                   String   @id @default(uuid())
  courseInstanceId     String   @map("course_instance_id")
  groupId              String   @map("group_id")
  evaluationStageId    String   @map("evaluation_stage_id")
  stageScorePercent    Float    @map("stage_score_percent")
  weightedContribution Float    @map("weighted_contribution")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  courseInstance CourseInstance  @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@unique([groupId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("final_marks")
}

// In-app notification (spec Section 10 / table notifications). type is an event
// key (e.g. "MARKS_PUBLISHED"); email delivery, when requested, goes through the
// shared email queue. readAt null = unread.
model Notification {
  id               String    @id @default(uuid())
  recipientUserId  String    @map("recipient_user_id")
  type             String
  title            String
  body             String
  courseInstanceId String?   @map("course_instance_id")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@map("notifications")
}
