generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The spec's 7 permission roles plus LECTURER: an approved lecturer who has
// no CPI-scoped role yet. Supervisor/Evaluator/Head Judge are per-CPI roles a
// lecturer takes on via junction tables (Week 3); LECTURER is the account-level
// base identity they hold in between.
enum Role {
  SUPER_ADMIN
  SYSTEM_ADMIN
  COURSE_COORDINATOR
  LECTURER
  SUPERVISOR
  EVALUATOR
  HEAD_JUDGE
  STUDENT
}

enum LecturerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A preset label only. Creating a CPI in a mode seeds CpiPolicy defaults; after
// that, mode gates nothing — every behavioural rule lives in CpiPolicy, so a
// Coordinator-Managed CPI can still have supervisors who post ideas and score.
enum CpiMode {
  SUPERVISOR_LED
  COORDINATOR_MANAGED
}

// Who confirms a group's project selection.
enum SelectionConfirmer {
  SUPERVISOR
  COORDINATOR
  EITHER
}

// Who is expected to submit scheduling availability.
enum AvailabilityRequirement {
  EVALUATORS_ONLY
  EVALUATORS_AND_SUPERVISORS
  NONE
}

// One answer in the availability grid. TENTATIVE is kept separate because
// "maybe" is still useful when building a timetable.
enum AvailabilityStatus {
  AVAILABLE
  TENTATIVE
  UNAVAILABLE
}

// Whether a timer part finished on time, late or early. Worked out when the part
// ends, and can be changed by hand.
enum SegmentTimeliness {
  ON_TIME
  OVERTIME
  UNDER
}

// What a person DOES on an evaluation panel. Deliberately independent of who
// they are (internal lecturer, coordinator, or external guest): an industry
// client whose problem a group is solving can sit as SENIOR_EVALUATOR on that
// one group's session and carry full weight.
enum PanelRole {
  COORDINATOR
  SUPERVISOR
  CO_SUPERVISOR
  SENIOR_EVALUATOR
  EVALUATOR
  JUNIOR_EVALUATOR
  HEAD_JUDGE
}

// How a panelist's scores reach the group's mark. COORDINATOR_DECIDES scores are
// pooled: averaged into a single contribution the coordinator then weights, so a
// crowd of walk-ins cannot outvote the formal panel by sheer number.
enum MarkCounting {
  COUNTED
  ADVISORY
  COORDINATOR_DECIDES
}

// Whether panelists on a stage may see each other's scores before review.
// ISOLATED is the default everywhere; the open modes exist for open events such
// as an FYP demonstration day and are an explicit, audit-logged choice.
enum PanelScoreVisibility {
  ISOLATED
  OPEN_WITH_NAMES
  OPEN_ANONYMOUS
}

// Whether a criterion is scored once for the whole group or once per student.
enum CriterionLevel {
  GROUP
  INDIVIDUAL
}

// Whether students take part as groups or individually (spec 3.3 Step 1).
// Stored at creation; acted on in Week 4's group formation.
enum CpiParticipationMode {
  GROUP
  INDIVIDUAL
}

// Supervisor invitations must be accepted by the lecturer (spec 3.3 Step 3);
// reused for group-membership invites too (leader invites → member accepts).
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Who authored a project idea (spec 3.3 Step 5 / table project_ideas).
enum IdeaAuthorType {
  SUPERVISOR
  COORDINATOR
  STUDENT
  LECTURER
}

// Visibility class, set from author type at creation. PUBLIC_TO_STUDENTS =
// every student may see it; GROUP_RESTRICTED = only the author's group (plus
// supervisors/coordinator). The real access check is per-requester in the list
// query — this is a readable label.
enum IdeaVisibility {
  PUBLIC_TO_STUDENTS
  GROUP_RESTRICTED
}

// Coordinator's accept/reject decision on a student idea — only meaningful in
// Coordinator-Managed mode (spec 3.3 Step 5). Null for all other ideas.
enum IdeaApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// Expression of Interest at Project Selection (spec 3.3 Step 6 / table
// interest_expressions). Interest is a flat expression — no ranking. A group or a lecturer may express
// as many as the policy allows, and withdraw while the phase is open.
//   GROUP_INTEREST          — a group is interested in a posted idea
//   SEEKING_SUPERVISOR      — a group flags its OWN idea, inviting supervisors
//   SUPERVISOR_WILLING      — a supervisor is willing to supervise a group idea
//   LECTURER_INTEREST       — a lecturer is interested in a group's idea
//   CO_SUPERVISION_INTEREST — a lecturer offers to co-supervise another's idea
enum EoiType {
  GROUP_INTEREST
  SEEKING_SUPERVISOR
  SUPERVISOR_WILLING
  LECTURER_INTEREST
  CO_SUPERVISION_INTEREST
}

enum SupervisorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProvisioningSubject {
  STUDENT
  LECTURER
}

enum ResearchOutputKind {
  PUBLICATION
  PROJECT
  GRANT
  OTHER
}

// Mutual-confirmation outcome for a group's chosen project (spec 3.3 Step 6 /
// table project_selections). PENDING until the supervisor (Supervisor-Led) or
// coordinator (Coordinator-Managed) responds.
enum SelectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// How an allocation row came to be (spec 3.3 Step 7). Either derived from a
// group's accepted selection, or set/changed by a coordinator override.
enum AllocationSource {
  FROM_SELECTION
  COORDINATOR_OVERRIDE
}

// AWAITING_REVIEW means "every required panelist has scored". Who reviews is
// resolved from policy — the Head Judge when one is enabled, otherwise the
// coordinator — so one status covers both flows.
enum SessionStatus {
  SCHEDULED
  AWAITING_REVIEW
  CORRECTION_REQUESTED
  FINALIZED
}

// A rubric score is locked once its session is approved at review (spec Flow B).
enum RubricScoreStatus {
  PENDING
  FINALIZED
}

enum ReviewDecision {
  APPROVED
  CORRECTION_REQUESTED
}

// 10 phases per CPI (spec 3.2) — every system action is gated to one of these.
enum CpiPhase {
  STUDENT_REGISTRATION
  SUPERVISOR_ADDITION
  IDEA_ANNOUNCEMENT
  PROJECT_SELECTION
  PROJECT_REGISTRATION
  EVALUATION_CONFIG
  PROPOSAL_SUBMISSION
  AVAILABILITY_SUBMISSION
  EVALUATION_EXECUTION
  FINAL_SUBMISSION
}

// All system users. `forcePasswordChange` is the single source of truth for
// the forced first-login flow (spec 9.1) — deliberately not duplicated on
// Student, to avoid two flags that can drift out of sync.
model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  fullName            String   @default("") @map("full_name")
  passwordHash        String   @map("password_hash")
  role                Role
  forcePasswordChange Boolean  @default(false) @map("force_password_change")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  student              Student?
  lecturer             Lecturer?
  createdCpis          CourseInstance[]      @relation("CpiCreatedBy")
  auditLogs            AuditLog[]
  provisioningLogs     ProvisioningLog[]
  postedIdeas          ProjectIdea[]
  notifications        Notification[]
  panelSeats           SessionPanelist[]     @relation("PanelistUser")
  panelSeatsAdded      SessionPanelist[]     @relation("PanelistAddedBy")
  guestsInvited        GuestPanelist[]       @relation("GuestInvitedBy")
  sessionReviews       SessionReview[]       @relation("SessionReviewer")
  markPublications     MarkPublication[]     @relation("MarksPublishedBy")
  pooledShareDecisions PooledShareDecision[] @relation("PooledShareDecidedBy")
  profile              UserProfile?
  supervisorDecisions  SupervisorRequest[]   @relation("SupervisorRequestDecidedBy")

  @@map("users")
}

// Extended profile for STUDENT-role users (spec 7.1).
model Student {
  id                 String  @id @default(uuid())
  userId             String  @unique @map("user_id")
  studentId          String  @unique @map("student_id")
  // Distinct from studentId: mark sheets carry both an index number and a
  // registration number. Nullable — older records have only the index.
  registrationNumber String? @unique @map("registration_number")
  department         String
  year               Int
  provisioningStatus String  @default("ACTIVE") @map("provisioning_status")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledGroups        Group[]       @relation("GroupLeader")
  groupMemberships GroupMember[]
  rubricScores     RubricScore[]
  studentMarks     StudentMark[]

  @@map("students")
}

// Extended profile for lecturer-type users (Course Coordinator / Supervisor /
// Evaluator / Head Judge are CPI-scoped roles a lecturer plays, added in
// Week 3 via junction tables — this is the base account record).
model Lecturer {
  id             String                 @id @default(uuid())
  userId         String                 @unique @map("user_id")
  selfRegistered Boolean                @default(false) @map("self_registered")
  approvalStatus LecturerApprovalStatus @default(PENDING) @map("approval_status")

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpiSupervisorRoles    CpiSupervisor[]
  cpiEvaluatorRoles     CpiEvaluator[]
  ideaSupervisorRoles   IdeaSupervisor[]
  supervisorRequests    SupervisorRequest[]
  willingExpressions    InterestExpression[]
  supervisorSelections  ProjectSelection[]
  supervisorAllocations ProjectAllocation[]
  panelSeats            SessionPanelist[]
  panelAvailability     PanelAvailability[]

  @@map("lecturers")
}

// A single run of a project-based course in a given semester/department
// (spec 3.1). Mode is a preset chosen at creation that seeds CpiPolicy; it is a
// label from then on, so behaviour is read from the policy, never from mode.
model CourseInstance {
  id          String @id @default(uuid())
  name        String // e.g. "Computer Engineering FYP 2026"
  projectType String @map("project_type") // free-text; coordinator-defined

  participationMode      CpiParticipationMode @map("participation_mode")
  department             String
  academicYear           String               @map("academic_year")
  mode                   CpiMode?
  allocationsFinalizedAt DateTime?            @map("allocations_finalized_at")
  createdById            String               @map("created_by_id")
  createdAt              DateTime             @default(now()) @map("created_at")

  createdBy            User                  @relation("CpiCreatedBy", fields: [createdById], references: [id])
  policy               CpiPolicy?
  guestPanelists       GuestPanelist[]
  timeline             CpiTimeline[]
  supervisors          CpiSupervisor[]
  evaluators           CpiEvaluator[]
  groups               Group[]
  ideas                ProjectIdea[]
  interestExpressions  InterestExpression[]
  supervisorRequests   SupervisorRequest[]
  projectSelections    ProjectSelection[]
  allocations          ProjectAllocation[]
  evaluationStages     EvaluationStage[]
  submissions          Submission[]
  availabilityTemplate AvailabilityTemplate?
  panelAvailability    PanelAvailability[]
  evaluationSessions   EvaluationSession[]
  finalMarks           FinalMark[]
  studentMarks         StudentMark[]
  gradeBands           GradeBand[]
  markPublications     MarkPublication[]

  @@map("course_instances")
}

// Every behavioural rule that used to be hard-coded or derived from CpiMode.
// One row per CPI, seeded from the mode preset at creation and editable by the
// coordinator thereafter. Explicit typed columns rather than a JSON blob so the
// settings stay queryable, migratable and validatable.
model CpiPolicy {
  id               String @id @default(uuid())
  courseInstanceId String @unique @map("course_instance_id")

  // Idea posting — who may author, and under what constraints.
  allowStudentIdeas          Boolean @default(true) @map("allow_student_ideas")
  studentIdeasLeaderOnly     Boolean @default(true) @map("student_ideas_leader_only")
  allowSupervisorIdeas       Boolean @default(true) @map("allow_supervisor_ideas")
  allowCoordinatorIdeas      Boolean @default(true) @map("allow_coordinator_ideas")
  allowLecturerIdeas         Boolean @default(false) @map("allow_lecturer_ideas")
  requireStudentIdeaApproval Boolean @default(false) @map("require_student_idea_approval")
  maxIdeasPerGroup           Int?    @map("max_ideas_per_group")
  allowCoSupervisorOnIdea    Boolean @default(true) @map("allow_co_supervisor_on_idea")

  // Project selection.
  interestEnabled                   Boolean            @default(true) @map("interest_enabled")
  maxInterestsPerGroup              Int?               @map("max_interests_per_group")
  allowInterestWithdrawal           Boolean            @default(true) @map("allow_interest_withdrawal")
  allowLecturerInterestInGroupIdeas Boolean            @default(true) @map("allow_lecturer_interest_in_group_ideas")
  allowCoSupervisionInterest        Boolean            @default(true) @map("allow_co_supervision_interest")
  studentsSeeOtherGroupIdeas        Boolean            @default(false) @map("students_see_other_group_ideas")
  allowSupervisorSelfRequest        Boolean            @default(true) @map("allow_supervisor_self_request")
  selectionConfirmedBy              SelectionConfirmer @default(SUPERVISOR) @map("selection_confirmed_by")

  // Participation shape.
  allowIndividualParticipation Boolean @default(false) @map("allow_individual_participation")
  autoCreateSoloGroup          Boolean @default(true) @map("auto_create_solo_group")

  // Evaluation.
  headJudgeEnabled         Boolean                 @default(false) @map("head_judge_enabled")
  requireOverallComment    Boolean                 @default(true) @map("require_overall_comment")
  availabilityRequiredFrom AvailabilityRequirement @default(EVALUATORS_ONLY) @map("availability_required_from")

  // Results.
  gradingEnabled        Boolean @default(false) @map("grading_enabled")
  caContributionPercent Float?  @map("ca_contribution_percent")

  updatedAt DateTime @updatedAt @map("updated_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)

  @@map("cpi_policies")
}

// Which lecturers the coordinator invited as supervisors for a CPI (spec 3.3
// Step 3 / table cpi_supervisors). Each invite must be accepted by the lecturer.
// Inviting a supervisor no longer changes the CPI's mode — see CpiPolicy.
model CpiSupervisor {
  id               String           @id @default(uuid())
  courseInstanceId String           @map("course_instance_id")
  lecturerId       String           @map("lecturer_id")
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")
  invitedAt        DateTime         @default(now()) @map("invited_at")
  respondedAt      DateTime?        @map("responded_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  lecturer       Lecturer       @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([courseInstanceId, lecturerId])
  @@map("cpi_supervisors")
}

// The CPI's evaluator pool — a convenience shortlist, no longer a gate: any
// approved lecturer can be seated on a session panel directly. isHeadJudge marks
// the CPI's default reviewer (at most one, enforced in the service), which seeds
// the HEAD_JUDGE seat on new panels when policy enables one.
model CpiEvaluator {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  lecturerId       String   @map("lecturer_id")
  isHeadJudge      Boolean  @default(false) @map("is_head_judge")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  courseInstance   CourseInstance    @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  lecturer         Lecturer          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  stageAssignments StageEvaluator[]
  panelSeats       SessionPanelist[]

  @@unique([courseInstanceId, lecturerId])
  @@map("cpi_evaluators")
}

// A student project group within a CPI (spec 3.3 Step 4). Mutable only during
// STUDENT_REGISTRATION; "locked" afterward is derived from the timeline, not stored.
model Group {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  name             String
  leaderStudentId  String   @map("leader_student_id")
  createdAt        DateTime @default(now()) @map("created_at")

  courseInstance      CourseInstance       @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  leader              Student              @relation("GroupLeader", fields: [leaderStudentId], references: [id])
  members             GroupMember[]
  ideas               ProjectIdea[]
  interestExpressions InterestExpression[]
  projectSelections   ProjectSelection[]
  allocation          ProjectAllocation?
  submissions         Submission[]
  evaluationSessions  EvaluationSession[]
  finalMarks          FinalMark[]
  studentMarks        StudentMark[]

  @@index([courseInstanceId])
  @@map("groups")
}

// Group membership + invite/accept flow (spec table group_members). Leader's row
// is ACCEPTED at creation; invitees start PENDING. "One accepted group per
// student per CPI" is enforced in the service layer.
model GroupMember {
  id        String           @id @default(uuid())
  groupId   String           @map("group_id")
  studentId String           @map("student_id")
  status    InvitationStatus @default(PENDING)
  invitedAt DateTime         @default(now()) @map("invited_at")
  joinedAt  DateTime?        @map("joined_at")

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
  @@map("group_members")
}

// A project idea (spec 3.3 Step 5). Author linkage by authorType: SUPERVISOR/
// COORDINATOR set authorUserId only; STUDENT sets authorUserId + groupId.
// approvalStatus is only set for STUDENT ideas in Coordinator-Managed mode.
// similarityFlag is a placeholder for the Week 9 ML similarity check.
model ProjectIdea {
  id               String              @id @default(uuid())
  courseInstanceId String              @map("course_instance_id")
  authorType       IdeaAuthorType      @map("author_type")
  authorUserId     String              @map("author_user_id")
  groupId          String?             @map("group_id")
  title            String
  description      String
  visibility       IdeaVisibility
  approvalStatus   IdeaApprovalStatus? @map("approval_status")
  revisionNote     String?             @map("revision_note")
  similarityFlag   Boolean             @default(false) @map("similarity_flag")
  createdAt        DateTime            @default(now()) @map("created_at")

  courseInstance      CourseInstance       @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  author              User                 @relation(fields: [authorUserId], references: [id])
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  interestExpressions InterestExpression[]
  projectSelections   ProjectSelection[]
  allocations         ProjectAllocation[]
  supervisors         IdeaSupervisor[]

  @@index([courseInstanceId])
  @@index([groupId])
  @@map("project_ideas")
}

// Expression of Interest at Project Selection (spec 3.3 Step 6 / table
// interest_expressions). One row per (group ranks an idea) / (group seeks a
// supervisor for its own idea) / (supervisor is willing on a student idea).
// Exactly one of groupId / supervisorLecturerId is set, per `type`.
model InterestExpression {
  id                   String    @id @default(uuid())
  courseInstanceId     String    @map("course_instance_id")
  ideaId               String    @map("idea_id")
  type                 EoiType
  groupId              String?   @map("group_id")
  supervisorLecturerId String?   @map("supervisor_lecturer_id")
  // Soft withdrawal: the row stays so the audit trail survives and the unique
  // pair still holds when the same interest is expressed again.
  withdrawnAt          DateTime? @map("withdrawn_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  idea           ProjectIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  group          Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  supervisor     Lecturer?      @relation(fields: [supervisorLecturerId], references: [id], onDelete: Cascade)

  // A group expresses a given interest at most once; likewise a lecturer.
  // (Semantics differ by type but the pair is unique either way, since only one
  // of group/supervisor is set.)
  @@unique([groupId, ideaId, type])
  @@unique([supervisorLecturerId, ideaId, type])
  @@index([courseInstanceId])
  @@index([ideaId])
  @@map("interest_expressions")
}

// A group's final project selection and its mutual-confirmation outcome (spec
// 3.3 Step 6 / table project_selections). supervisorLecturerId is set in
// Supervisor-Led (the supervisor who must accept), null in Coordinator-Managed
// (the coordinator approves). "One active (non-declined) selection per group"
// is enforced in the service layer.
model ProjectSelection {
  id                   String          @id @default(uuid())
  courseInstanceId     String          @map("course_instance_id")
  groupId              String          @map("group_id")
  ideaId               String          @map("idea_id")
  supervisorLecturerId String?         @map("supervisor_lecturer_id")
  status               SelectionStatus @default(PENDING)
  createdAt            DateTime        @default(now()) @map("created_at")
  respondedAt          DateTime?       @map("responded_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  idea           ProjectIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  supervisor     Lecturer?      @relation(fields: [supervisorLecturerId], references: [id], onDelete: Cascade)

  @@index([courseInstanceId])
  @@index([groupId])
  @@map("project_selections")
}

// Supervisors attached to an idea. The author is the primary; anyone else was
// named by them (from the approved list, or invited) and must accept. Shown to
// groups on the idea so they know who they would be working with.
model IdeaSupervisor {
  id               String           @id @default(uuid())
  ideaId           String           @map("idea_id")
  lecturerId       String           @map("lecturer_id")
  isPrimary        Boolean          @default(false) @map("is_primary")
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")
  invitedAt        DateTime         @default(now()) @map("invited_at")
  respondedAt      DateTime?        @map("responded_at")

  idea     ProjectIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  lecturer Lecturer    @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([ideaId, lecturerId])
  @@index([ideaId])
  @@map("idea_supervisors")
}

// A lecturer asking a coordinator to make them a supervisor on a course they
// found themselves. Deliberately its own model rather than another value on
// InvitationStatus, which is shared with group membership.
model SupervisorRequest {
  id               String                  @id @default(uuid())
  courseInstanceId String                  @map("course_instance_id")
  lecturerId       String                  @map("lecturer_id")
  status           SupervisorRequestStatus @default(PENDING)
  note             String?
  decidedById      String?                 @map("decided_by_id")
  decidedAt        DateTime?               @map("decided_at")
  createdAt        DateTime                @default(now()) @map("created_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  lecturer       Lecturer       @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  decidedBy      User?          @relation("SupervisorRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([courseInstanceId, lecturerId])
  @@index([courseInstanceId])
  @@map("supervisor_requests")
}

// Institution-wide directory profile. Visible to any logged-in user; guests
// authenticating with a scoring link are deliberately excluded, since their
// access is scoped to the sessions they mark.
model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  headline     String?
  about        String?
  department   String?
  designation  String?
  contactEmail String?  @map("contact_email")
  links        Json?
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests ResearchInterest[]
  outputs   ResearchOutput[]

  @@map("user_profiles")
}

// Tagged research areas, so a student can filter supervisors by area instead of
// reading every profile.
model ResearchInterest {
  id        String @id @default(uuid())
  profileId String @map("profile_id")
  area      String

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, area])
  @@index([area])
  @@map("research_interests")
}

model ResearchOutput {
  id        String             @id @default(uuid())
  profileId String             @map("profile_id")
  title     String
  venue     String?
  year      Int?
  url       String?
  kind      ResearchOutputKind @default(PUBLICATION)

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("research_outputs")
}

// Finalized group ↔ project ↔ supervisor assignment (spec 3.3 Step 7 / table
// project_allocations). One per group. Seeded from accepted selections, then
// editable by the coordinator until the CPI's allocations are finalized
// (CourseInstance.allocationsFinalizedAt).
model ProjectAllocation {
  id                   String           @id @default(uuid())
  courseInstanceId     String           @map("course_instance_id")
  groupId              String           @unique @map("group_id")
  ideaId               String           @map("idea_id")
  supervisorLecturerId String?          @map("supervisor_lecturer_id")
  source               AllocationSource @default(FROM_SELECTION)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  idea           ProjectIdea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  supervisor     Lecturer?      @relation(fields: [supervisorLecturerId], references: [id], onDelete: Cascade)

  @@index([courseInstanceId])
  @@map("project_allocations")
}

// A customizable evaluation stage (spec 3.3 Step 8 / table evaluation_stages).
// weight is a percentage; stage weights sum to 100 across the CPI.
model EvaluationStage {
  id                    String               @id @default(uuid())
  courseInstanceId      String               @map("course_instance_id")
  name                  String
  weight                Int // percent; stages sum to 100 per CPI
  submissionRequired    Boolean              @default(false) @map("submission_required")
  // Per-stage submission window; when null, submissions fall back to the CPI's
  // PROPOSAL_SUBMISSION phase window (so multi-stage submissions can differ).
  submissionWindowStart DateTime?            @map("submission_window_start")
  submissionWindowEnd   DateTime?            @map("submission_window_end")
  // Per-stage scoring/presentation window; when set, this stage can only be
  // scored within it (so proposal/mid/final each run at their own time inside
  // the EVALUATION_EXECUTION phase). When null, the phase window alone governs.
  executionWindowStart  DateTime?            @map("execution_window_start")
  executionWindowEnd    DateTime?            @map("execution_window_end")
  orderIndex            Int                  @map("order_index")
  // Whether panelists on this stage see each other's scores before review.
  // ISOLATED unless the coordinator deliberately opens it for an open event.
  panelScoreVisibility  PanelScoreVisibility @default(ISOLATED) @map("panel_score_visibility")
  // Pooled contribution from COORDINATOR_DECIDES panelists (walk-in lecturers,
  // guests without a formal role): their scores are averaged into one figure
  // weighted by pooledSharePercent. Null means they do not count at all.
  // pooledScorerLimit caps how many of them count and is validated as uniform
  // across every group in the stage, so panels of unequal size stay comparable.
  pooledSharePercent    Float?               @map("pooled_share_percent")
  pooledScorerLimit     Int?                 @map("pooled_scorer_limit")
  createdAt             DateTime             @default(now()) @map("created_at")

  courseInstance       CourseInstance         @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  criteria             RubricCriterion[]
  evaluators           StageEvaluator[]
  panelRules           StagePanelRule[]
  timerSegments        TimerSegmentTemplate[]
  pooledShareDecisions PooledShareDecision[]
  submissions          Submission[]
  sessions             EvaluationSession[]
  finalMarks           FinalMark[]
  studentMarks         StudentMark[]
  markPublications     MarkPublication[]

  @@index([courseInstanceId])
  @@map("evaluation_stages")
}

// A rubric criterion within a stage (spec table rubric_criteria). weight is a
// percentage; criteria weights sum to 100 within their stage.
model RubricCriterion {
  id                String         @id @default(uuid())
  evaluationStageId String         @map("evaluation_stage_id")
  name              String
  description       String?
  weight            Int // percent within the stage; criteria sum to 100
  maxScore          Int            @map("max_score")
  // GROUP criteria are scored once for the whole group; INDIVIDUAL criteria are
  // scored once per student, which is what lets members of one group differ.
  level             CriterionLevel @default(GROUP)
  orderIndex        Int            @map("order_index")

  stage  EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  scores RubricScore[]

  @@index([evaluationStageId])
  @@map("rubric_criteria")
}

// The composition a stage expects, per role: how many are required, how many are
// allowed, what their scores weigh, and whether anyone may join. This is where
// "coordinator + supervisor + evaluator are mandatory" is expressed — three rows
// with minRequired 1 — and equally where an open FYP demonstration is expressed:
// zero required evaluators plus one openToAll row.
model StagePanelRule {
  id                String       @id @default(uuid())
  evaluationStageId String       @map("evaluation_stage_id")
  role              PanelRole
  minRequired       Int          @default(0) @map("min_required")
  maxAllowed        Int?         @map("max_allowed")
  weightPercent     Float?       @map("weight_percent")
  markCounting      MarkCounting @default(COUNTED) @map("mark_counting")
  openToAll         Boolean      @default(false) @map("open_to_all")

  stage EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@unique([evaluationStageId, role])
  @@map("stage_panel_rules")
}

// One person's seat on one session's panel. Because a session is a single group
// at a single stage, every group can have a different panel at the same event —
// different supervisor, different evaluators, its own guests. Exactly one
// identity column is set; internal people also carry userId so authorization
// never has to branch on which kind they are.
model SessionPanelist {
  id                  String        @id @default(uuid())
  evaluationSessionId String        @map("evaluation_session_id")
  role                PanelRole
  userId              String?       @map("user_id")
  lecturerId          String?       @map("lecturer_id")
  cpiEvaluatorId      String?       @map("cpi_evaluator_id")
  guestPanelistId     String?       @map("guest_panelist_id")
  // Overrides for this one seat; null falls back to the stage's rule for the role.
  weightPercent       Float?        @map("weight_percent")
  markCounting        MarkCounting? @map("mark_counting")
  addedById           String?       @map("added_by_id")
  joinedAt            DateTime      @default(now()) @map("joined_at")

  session      EvaluationSession  @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  user         User?              @relation("PanelistUser", fields: [userId], references: [id], onDelete: Cascade)
  lecturer     Lecturer?          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  cpiEvaluator CpiEvaluator?      @relation(fields: [cpiEvaluatorId], references: [id], onDelete: Cascade)
  guest        GuestPanelist?     @relation(fields: [guestPanelistId], references: [id], onDelete: Cascade)
  addedBy      User?              @relation("PanelistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  scores       RubricScore[]
  evaluation   SessionEvaluation?

  // One seat per person per session — a person cannot hold two roles at once,
  // which is also what stops their marks being counted twice.
  @@unique([evaluationSessionId, userId])
  @@unique([evaluationSessionId, guestPanelistId])
  @@index([evaluationSessionId])
  @@map("session_panelists")
}

// An external participant (industry professional, visiting academic) invited to
// score specific sessions. No account and no password: they authenticate with a
// one-time link whose SHA-256 hash is stored here. Scoped to the sessions they
// hold a seat on, so a client tied to one group never sees another's.
model GuestPanelist {
  id               String    @id @default(uuid())
  courseInstanceId String    @map("course_instance_id")
  fullName         String    @map("full_name")
  email            String
  organization     String?
  tokenHash        String    @unique @map("token_hash")
  tokenExpiresAt   DateTime  @map("token_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  invitedById      String    @map("invited_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  courseInstance CourseInstance    @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  invitedBy      User              @relation("GuestInvitedBy", fields: [invitedById], references: [id])
  panelSeats     SessionPanelist[]

  @@index([courseInstanceId])
  @@map("guest_panelists")
}

// The mandatory overall comment a panelist writes about a session, separate from
// the optional per-criterion comments. Required unless CpiPolicy says otherwise.
model SessionEvaluation {
  id                String   @id @default(uuid())
  sessionPanelistId String   @unique @map("session_panelist_id")
  overallComment    String   @map("overall_comment")
  submittedAt       DateTime @default(now()) @map("submitted_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  panelist SessionPanelist @relation(fields: [sessionPanelistId], references: [id], onDelete: Cascade)

  @@map("session_evaluations")
}

// The coordinator's decision on how much a stage's pooled (COORDINATOR_DECIDES)
// scores count. Taken with the scores already visible, so the reason is required
// and the whole decision is kept as an audit record.
model PooledShareDecision {
  id                String   @id @default(uuid())
  evaluationStageId String   @map("evaluation_stage_id")
  sharePercent      Float    @map("share_percent")
  scorerLimit       Int?     @map("scorer_limit")
  reason            String
  decidedById       String   @map("decided_by_id")
  decidedAt         DateTime @default(now()) @map("decided_at")

  stage     EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  decidedBy User            @relation("PooledShareDecidedBy", fields: [decidedById], references: [id])

  @@index([evaluationStageId])
  @@map("pooled_share_decisions")
}

// Default evaluators for a stage. These seed each new session's panel; the panel
// itself is then editable per session, so swapping an unavailable evaluator is a
// one-row change and does not disturb any other group.
model StageEvaluator {
  id                String @id @default(uuid())
  evaluationStageId String @map("evaluation_stage_id")
  cpiEvaluatorId    String @map("cpi_evaluator_id")

  stage        EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  cpiEvaluator CpiEvaluator    @relation(fields: [cpiEvaluatorId], references: [id], onDelete: Cascade)

  @@unique([evaluationStageId, cpiEvaluatorId])
  @@map("stage_evaluators")
}

// A group's file submission for a stage (spec 3.3 Step 9 / table submissions).
// storagePath is backend-agnostic (local path or Supabase object key). isLate
// is computed against the submission window at upload time — the deadline is
// SOFT (late uploads are accepted and flagged, per spec "late submissions
// flagged to coordinator"). One current submission per group per stage.
model Submission {
  id                String   @id @default(uuid())
  courseInstanceId  String   @map("course_instance_id")
  groupId           String   @map("group_id")
  evaluationStageId String   @map("evaluation_stage_id")
  storagePath       String   @map("storage_path")
  fileName          String   @map("file_name")
  fileSize          Int      @map("file_size")
  isLate            Boolean  @default(false) @map("is_late")
  submittedAt       DateTime @default(now()) @map("submitted_at")

  courseInstance CourseInstance  @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@unique([groupId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("submissions")
}

// The shape of a course's availability grid: a range of dates across the top and
// named time slots down the side, so everyone answers the same questions.
model AvailabilityTemplate {
  id               String   @id @default(uuid())
  courseInstanceId String   @unique @map("course_instance_id")
  windowStart      DateTime @map("window_start") @db.Date
  windowEnd        DateTime @map("window_end") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  courseInstance CourseInstance             @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  slots          AvailabilityTemplateSlot[]

  @@map("availability_templates")
}

// One row of the grid, e.g. "Morning 09:00–12:00". Times are plain HH:mm text
// because the slot repeats on every date, so it is not one exact moment.
model AvailabilityTemplateSlot {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  name       String
  startTime  String @map("start_time") // HH:mm, local to the department
  endTime    String @map("end_time") // HH:mm
  orderIndex Int    @map("order_index")

  template AvailabilityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entries  PanelAvailability[]

  @@index([templateId])
  @@map("availability_template_slots")
}

// One person's answer for one cell. Linked to the lecturer, not to their place in
// the evaluator list, so a supervisor who is not an evaluator can still answer.
model PanelAvailability {
  id               String             @id @default(uuid())
  courseInstanceId String             @map("course_instance_id")
  lecturerId       String             @map("lecturer_id")
  templateSlotId   String             @map("template_slot_id")
  slotDate         DateTime           @map("slot_date") @db.Date
  status           AvailabilityStatus
  note             String?
  updatedAt        DateTime           @updatedAt @map("updated_at")

  courseInstance CourseInstance           @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  lecturer       Lecturer                 @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  templateSlot   AvailabilityTemplateSlot @relation(fields: [templateSlotId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, slotDate, templateSlotId])
  @@index([courseInstanceId])
  @@map("panel_availability")
}

// A scheduled evaluation of one group at one stage (spec table
// evaluation_sessions). Its evaluators are the stage's assigned evaluators;
// scores hang off it. status tracks the Flow B lifecycle.
model EvaluationSession {
  id                          String        @id @default(uuid())
  courseInstanceId            String        @map("course_instance_id")
  groupId                     String        @map("group_id")
  evaluationStageId           String        @map("evaluation_stage_id")
  scheduledStart              DateTime?     @map("scheduled_start")
  scheduledEnd                DateTime?     @map("scheduled_end")
  // How long this group should get. Can be set before any times are chosen.
  allocatedMinutes            Int?          @map("allocated_minutes")
  location                    String? // free text: room, video link, or blank
  // Final elapsed presentation time (set when the shared timer is stopped).
  presentationDurationSeconds Int?          @map("presentation_duration_seconds")
  // The clock for the whole session. Time so far is accumulated, plus the time
  // since it was started if it is running. Each part has its own clock in
  // SessionTimerSegment.
  timerStartedAt              DateTime?     @map("timer_started_at")
  timerAccumulatedSeconds     Int           @default(0) @map("timer_accumulated_seconds")
  timerRunning                Boolean       @default(false) @map("timer_running")
  // Which part the room is on. Only a Next moves it; reaching a target does not.
  currentSegmentIndex         Int           @default(0) @map("current_segment_index")
  status                      SessionStatus @default(SCHEDULED)
  createdAt                   DateTime      @default(now()) @map("created_at")

  courseInstance CourseInstance        @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage       @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  panelists      SessionPanelist[]
  scores         RubricScore[]
  timerSegments  SessionTimerSegment[]
  review         SessionReview?

  @@unique([groupId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("evaluation_sessions")
}

// The order a stage's presentations follow. It is copied onto a session the first
// time its clock runs, so changing it later cannot change a finished session.
model TimerSegmentTemplate {
  id                String @id @default(uuid())
  evaluationStageId String @map("evaluation_stage_id")
  name              String
  targetSeconds     Int    @map("target_seconds")
  orderIndex        Int    @map("order_index")

  stage EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@index([evaluationStageId])
  @@map("timer_segment_templates")
}

// One part of one session's presentation, with its own clock. Going past the
// target does not move to the next part, it just counts the extra time. Moving on
// is always done by hand, which is what makes running late visible.
model SessionTimerSegment {
  id                  String             @id @default(uuid())
  evaluationSessionId String             @map("evaluation_session_id")
  orderIndex          Int                @map("order_index")
  name                String
  targetSeconds       Int                @map("target_seconds")
  accumulatedSeconds  Int                @default(0) @map("accumulated_seconds")
  startedAt           DateTime?          @map("started_at")
  running             Boolean            @default(false)
  completedAt         DateTime?          @map("completed_at")
  overranSeconds      Int                @default(0) @map("overran_seconds")
  timeliness          SegmentTimeliness? // null until the part finishes
  // True when someone changed the on time / late / early result by hand.
  timelinessManual    Boolean            @default(false) @map("timeliness_manual")

  session EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@unique([evaluationSessionId, orderIndex])
  @@map("session_timer_segments")
}

// One panelist's score for one criterion in a session (spec table rubric_scores).
// studentId is null for a GROUP criterion and set for an INDIVIDUAL one. Score
// visibility is enforced in the service read path against the stage's
// panelScoreVisibility, not here. Locked once status=FINALIZED.
//
// Uniqueness is enforced by two partial indexes created in the migration rather
// than an @@unique here: Postgres treats NULLs as distinct, so a plain compound
// unique would let the same panelist score one group criterion twice.
model RubricScore {
  id                  String            @id @default(uuid())
  evaluationSessionId String            @map("evaluation_session_id")
  sessionPanelistId   String            @map("session_panelist_id")
  rubricCriterionId   String            @map("rubric_criterion_id")
  studentId           String?           @map("student_id")
  score               Int
  comment             String?
  status              RubricScoreStatus @default(PENDING)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  session   EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  panelist  SessionPanelist   @relation(fields: [sessionPanelistId], references: [id], onDelete: Cascade)
  criterion RubricCriterion   @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  student   Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([evaluationSessionId])
  @@index([sessionPanelistId])
  @@map("rubric_scores")
}

// The reviewer's decision on a session. Who reviews is resolved from policy —
// the Head Judge when one is enabled, otherwise the coordinator — so this stores
// the deciding user rather than a Head Judge reference. correctionPanelistId
// names the panelist asked to resubmit.
model SessionReview {
  id                   String         @id @default(uuid())
  evaluationSessionId  String         @unique @map("evaluation_session_id")
  reviewerUserId       String         @map("reviewer_user_id")
  decision             ReviewDecision
  reason               String?
  correctionPanelistId String?        @map("correction_panelist_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  session  EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)
  reviewer User              @relation("SessionReviewer", fields: [reviewerUserId], references: [id])

  @@map("session_reviews")
}

// Phase start/end dates per CPI — one row per phase (spec 7.1).
model CpiTimeline {
  id               String   @id @default(uuid())
  courseInstanceId String   @map("course_instance_id")
  phase            CpiPhase
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)

  @@unique([courseInstanceId, phase])
  @@map("cpi_timelines")
}

// Append-only trail of every write operation (spec 7.1: "never deleted").
// actorId is nullable so unauthenticated writes (login attempts, lecturer
// self-registration) are still recorded. payloadHash is a SHA-256 of the
// request body — a fingerprint for integrity disputes without ever storing
// raw payload contents (which may include passwords or student PII).
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  action      String // e.g. "POST /students/bulk-provision"
  resource    String // route path actually hit, with params resolved
  payloadHash String?  @map("payload_hash")
  statusCode  Int      @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

// One row per provisioned account per bulk upload (spec 2.2): records that the
// credential email was dispatched and whether it arrived, so failed deliveries
// can be flagged for System Admin review. Shared by students and lecturers —
// the pipeline is identical, only the subject differs.
model ProvisioningLog {
  id             String              @id @default(uuid())
  batchId        String              @map("batch_id")
  subjectType    ProvisioningSubject @default(STUDENT) @map("subject_type")
  userId         String              @map("user_id")
  email          String
  deliveryStatus EmailDeliveryStatus @default(QUEUED) @map("delivery_status")
  failureReason  String?             @map("failure_reason")
  dispatchedAt   DateTime?           @map("dispatched_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([deliveryStatus])
  @@map("provisioning_log")
}

// Aggregated mark per group per stage (spec 3.3 Step 11 / table final_marks).
// stageScorePercent is the stage's 0–100 result; weightedContribution applies
// the stage weight. Overall = sum of weightedContribution per group.
model FinalMark {
  id                   String   @id @default(uuid())
  courseInstanceId     String   @map("course_instance_id")
  groupId              String   @map("group_id")
  evaluationStageId    String   @map("evaluation_stage_id")
  stageScorePercent    Float    @map("stage_score_percent")
  weightedContribution Float    @map("weighted_contribution")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  courseInstance CourseInstance  @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@unique([groupId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("final_marks")
}

// In-app notification (spec Section 10 / table notifications). type is an event
// key (e.g. "MARKS_PUBLISHED"); email delivery, when requested, goes through the
// shared email queue. readAt null = unread.
// One student's mark for one stage. FinalMark stays as the group's view; this is
// what lets two members of the same group end up with different results, because
// INDIVIDUAL criteria are scored per person while GROUP criteria are shared.
model StudentMark {
  id                         String   @id @default(uuid())
  courseInstanceId           String   @map("course_instance_id")
  studentId                  String   @map("student_id")
  groupId                    String   @map("group_id")
  evaluationStageId          String   @map("evaluation_stage_id")
  // The two halves kept apart so a student can see which part of their mark was
  // the group's work and which was their own.
  groupComponentPercent      Float    @map("group_component_percent")
  individualComponentPercent Float?   @map("individual_component_percent")
  stageScorePercent          Float    @map("stage_score_percent")
  weightedContribution       Float    @map("weighted_contribution")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  courseInstance CourseInstance  @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage          EvaluationStage @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)

  @@unique([studentId, evaluationStageId])
  @@index([courseInstanceId])
  @@map("student_marks")
}

// A letter grade and the lowest mark that earns it. Only used when the course
// has grading turned on; courses that award CA marks only have no bands.
model GradeBand {
  id               String @id @default(uuid())
  courseInstanceId String @map("course_instance_id")
  label            String // A+, A, B+ ...
  minPercent       Float  @map("min_percent")
  orderIndex       Int    @map("order_index")

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)

  @@unique([courseInstanceId, label])
  @@index([courseInstanceId])
  @@map("grade_bands")
}

// What students may see, per stage or for the whole course. Replaces a single
// timestamp that could be set once and never cleared. Marks and comments are
// separate switches, so feedback can go out before the numbers.
//
// evaluationStageId null means the whole course. Postgres treats nulls as
// different from each other, so that row is kept unique by a partial index in
// the migration rather than by @@unique here.
model MarkPublication {
  id                String    @id @default(uuid())
  courseInstanceId  String    @map("course_instance_id")
  evaluationStageId String?   @map("evaluation_stage_id")
  publishMarks      Boolean   @default(false) @map("publish_marks")
  publishComments   Boolean   @default(false) @map("publish_comments")
  // Released separately and usually later: marks go out during the semester,
  // the grade only once everything is in.
  publishGrades     Boolean   @default(false) @map("publish_grades")
  publishedAt       DateTime? @map("published_at")
  publishedById     String?   @map("published_by_id")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  courseInstance CourseInstance   @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  stage          EvaluationStage? @relation(fields: [evaluationStageId], references: [id], onDelete: Cascade)
  publishedBy    User?            @relation("MarksPublishedBy", fields: [publishedById], references: [id])

  @@index([courseInstanceId])
  @@map("mark_publications")
}

model Notification {
  id               String    @id @default(uuid())
  recipientUserId  String    @map("recipient_user_id")
  type             String
  title            String
  body             String
  courseInstanceId String?   @map("course_instance_id")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@map("notifications")
}
