PORT=4000

# Postgres. DIRECT_URL is read by the Prisma CLI only (migrations); locally both
# point at the same database. On Supabase, use the session pooler string (5432)
# for both — the transaction pooler (6543) cannot run migrations.
DATABASE_URL=postgresql://psems:psems_dev_password@localhost:5432/psems_dev
DIRECT_URL=postgresql://psems:psems_dev_password@localhost:5432/psems_dev

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=changeme_generate_a_long_random_string
JWT_REFRESH_SECRET=changeme_generate_a_different_long_random_string

# Comma-separated origins allowed to send credentialed requests. Unset reflects
# any origin, which is only acceptable in development.
# CORS_ORIGINS=https://psems.live,https://www.psems.live

# Only when the SPA and API are on different registrable domains. Leave unset
# when they share one (psems.live + api.psems.live).
# COOKIE_SAMESITE=none

# File storage: "local" writes to STORAGE_DIR, "supabase" needs the three below.
STORAGE_BACKEND=local
STORAGE_DIR=uploads
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=submissions

# Optional: restricts lecturer self-registration to one email domain.
# UNIVERSITY_EMAIL_DOMAIN=eng.university.lk

# Optional: SMTP for real email. Unset means messages are logged, not sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=PSEMS <no-reply@psems.live>

ML_SERVICE_URL=http://localhost:8000
